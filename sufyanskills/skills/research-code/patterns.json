        "confidence": 0.7,
        "note": "May be new code - check codebook"
      },
      {
        "keywords": ["compli", "governance", "guideline", "policy"],
        "suggests_code": "Governance",
        "confidence": 0.6,
        "note": "May be new code - check codebook"
      }
    ]
  },

  "quotable_signals": {
    "_description": "Phrases that often indicate quotable moments",
    "patterns": [
      {
        "keywords": ["everywhere", "all over", "scattered"],
        "note": "Often describes fragmentation vividly"
      },
      {
        "keywords": ["the key is", "the thing is", "the issue is", "the problem is"],
        "note": "Speaker summarizing a core insight"
      },
      {
        "keywords": ["I wish", "if only", "ideally"],
        "note": "Expressing desired state"
      }
    ]
  }
}

        "suggests_code": "Manual data entry",
        "confidence": 0.7
      },
      {
        "keywords": ["clean", "cleaning", "clean up", "massage"],
        "suggests_code": "Data transformation",
        "confidence": 0.6
      },
      {
        "keywords": ["centrali"],
        "suggests_code": "Data centralization",
        "confidence": 0.8,
        "note": "Matches centralize, centralized, centralising, centralisation"
      },
      {
        "keywords": ["download", "export", "extract"],
        "suggests_code": "Data download",
        "confidence": 0.6
      },
      {
        "keywords": ["upload", "import", "push"],
        "suggests_code": "Data upload",
        "confidence": 0.6
      },
      {
        "keywords": ["automat"],
        "suggests_code": "Automation effort",
        "confidence": 0.7
      },
      {
        "keywords": ["frustrat", "annoying", "painful", "hate", "tedious"],
        "suggests_code": "Pain point (unspecified)",
        "confidence": 0.8,
        "note": "Strong emotional language indicates friction"
      },
      {
        "keywords": ["ideally", "wish", "would be nice", "if only"],
        "suggests_code": "Desired state",
        "confidence": 0.7
